<section class="section">
  <div class="container">
    <h1>Collections</h1>
    <div class="grid grid-3">
      {% for collection in collections %}
        <article class="card"><h3><a href="{{ collection.url }}">{{ collection.title }}</a></h3></article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Main list collections", "settings": [] }
{% endschema %}
