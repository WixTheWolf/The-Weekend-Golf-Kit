<section class="hero">
  <div class="container">
    <h1>{{ section.settings.heading }}</h1>
    <p class="muted">{{ section.settings.subheading }}</p>
    <a class="btn" href="{{ section.settings.primary_url }}">{{ section.settings.primary_cta }}</a>
    <a class="btn alt" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_cta }}</a>
  </div>
</section>
{% schema %}
{
  "name": "Homepage hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Golf essentials for the round before the round." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Premium kits, accessories, and small-bag upgrades built for weekend golfers, trips, tournaments, and early tee times." },
    { "type": "text", "id": "primary_cta", "label": "Primary CTA", "default": "Shop The Weekend Kit" },
    { "type": "url", "id": "primary_url", "label": "Primary URL" },
    { "type": "text", "id": "secondary_cta", "label": "Secondary CTA", "default": "Explore Accessories" },
    { "type": "url", "id": "secondary_url", "label": "Secondary URL" }
  ],
  "presets": [{"name": "Homepage hero"}]
}
{% endschema %}
